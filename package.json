{
  "name": "tus-local-prototype",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "test": "node --test tests/prototype/*.test.cjs",
    "build": "python3 tools/prototype/build.py",
    "check": "node --check prototype/core.js && node --check prototype/app.js && node --check prototype/sw.js",
    "test:browser": "node --test tests/browser/session-store.spec.cjs && node tests/browser/preview.spec.cjs",
    "test:emulated": "python3 tools/preview/build.py && node --test tests/emulated/*.test.cjs",
    "build:preview": "python3 tools/preview/build.py"
  },
  "devDependencies": {
    "playwright": "1.63.0",
    "fake-indexeddb": "6.2.5",
    "linkedom": "0.18.13"
  }
}
